NODE_ENV=development
PORT=4000

# MongoDB (local or Atlas connection string).
# Optional: if MongoDB is unreachable the API uses an in-memory store instead.
MONGODB_URI=mongodb://127.0.0.1:27017/movie-app

# TMDB API v3 key: https://www.themoviedb.org/settings/api
# One key covers films and series (discover/movie, search/multi, discover/tv).
# Optional: leave empty to serve the bundled 18-film / 12-series offline catalog.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_LANGUAGE=en-US

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
# Required in production; development falls back to a local-only secret.
JWT_SECRET=replace-me-with-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# React client origin(s) allowed by CORS (comma-separated, or *)
CLIENT_ORIGIN=http://localhost:5173
# Set true only behind a trusted reverse proxy so rate limits use the real client IP.
TRUST_PROXY=false

# Maximum movies stored in one user's embedded watchlist.
MAX_WATCHLIST_ITEMS=500

# LLM for /api/search/semantic. Any OpenAI-compatible API works.
# Optional: without a key, a deterministic local interpreter handles semantic search.
# OpenAI example: https://api.openai.com/v1 + gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Abandon a stalled provider request after this many milliseconds.
LLM_TIMEOUT_MS=15000
# Process-local daily budget protecting your API key from runaway spend.
LLM_DAILY_LIMIT=1000
